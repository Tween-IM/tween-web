.mx_TmcpEventBody_card {
    padding: 16px;
    border-radius: 12px;
    background: $system;
    border: 1px solid $quinary-content;
    max-width: 300px;
    margin: 8px 0;
    box-shadow: 0 4px 6px rgb(0, 0, 0, 0.1);

    .mx_TmcpEventBody_card_header {
        font-size: $font-12px;
        text-transform: uppercase;
        font-weight: 600;
        color: $secondary-content;
        margin-bottom: 8px;
    }

    .mx_TmcpEventBody_card_amount {
        font-size: $font-24px;
        font-weight: bold;
        color: $primary-content;
        margin-bottom: 4px;
    }

    .mx_TmcpEventBody_card_description,
    .mx_TmcpEventBody_card_message,
    .mx_TmcpEventBody_card_body {
        font-size: $font-14px;
        color: $primary-content;
        margin-bottom: 8px;
    }

    .mx_TmcpEventBody_card_button {
        width: 100%;
        margin-top: 12px;
    }

    &.mx_TmcpEventBody_richCard {
        border-color: $accent;
    }

    &.mx_TmcpEventBody_p2pCard {
        background-color: rgba($accent, 0.05);
        border-left: 4px solid $accent;
    }

    &.mx_TmcpEventBody_activationCard {
        background-color: rgb($alert / 0.05);
        border-left: 4px solid $alert;
    }

    .mx_TmcpEventBody_card_actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;

        .mx_AccessibleButton {
            flex: 1;
        }
    }

    &.mx_TmcpEventBody_paymentCard {
        border-left: 4px solid $accent;

        &.mx_TmcpEventBody_completed {
            border-left-color: $accent-600;
        }
    }

    &.mx_TmcpEventBody_giftCard {
        background: linear-gradient(135deg, $accent 0%, $primary-content 100%);
        color: white;
        border: none;

        .mx_TmcpEventBody_card_header,
        .mx_TmcpEventBody_card_amount,
        .mx_TmcpEventBody_card_message {
            color: white;
        }
        
        .mx_TmcpEventBody_card_header {
            opacity: 0.8;
        }
    }

    .mx_TmcpEventBody_card_image {
        width: 100%;
        border-radius: 8px;
        margin-top: 12px;
    }
}

.mx_TmcpEventBody_fallback {
    font-style: italic;
    color: $secondary-content;
    padding: 8px;
}
